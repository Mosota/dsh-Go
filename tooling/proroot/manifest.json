      "regex": "^dsh web: (http://127\\.0\\.0\\.1:[0-9]+/)\\?token=([A-Za-z0-9_-]+)",
      "example": "dsh web: http://127.0.0.1:3080/?token=<43 base64url chars>",
      "note": "printed once, after every plugin has loaded; the server is listening by then"
    },
    "auth": {
      "exchange": "GET /?token=<token> -> 303 Location ./ + Set-Cookie dsh-auth-<id>=v1.<...>; Path=/; HttpOnly; SameSite=Strict",
      "webview": "either load the token URL directly, or exchange it natively and CookieManager.setCookie(baseUrl, cookie + '; Path=/; HttpOnly; SameSite=Strict')"
    },
    "health": {
      "tcp": "127.0.0.1:{PORT} accepts",
      "http": "GET / without cookie -> 401 (server up, unauthenticated); with the dsh-auth cookie -> 200"
    },
    "stop": {
      "pidFile": "{ROOTFS}/tmp/dsh-web.pid",
      "graceful": "Os.kill(pid from pidFile, SIGTERM): dsh disposes plugins and exits 0; --kill-on-exit then reaps the rest and proot exits",
      "fallback": "Os.kill(prootPid, SIGQUIT) kills every tracee; proot IGNORES SIGTERM/SIGINT/SIGHUP, so Process.destroy() alone does nothing and destroyForcibly() orphans node"
